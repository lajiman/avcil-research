# AV-CIL research project: repository migration policy v2.
# Ignoring a path does NOT delete its files or back them up.
# PENDING REVIEW sections are temporary exclusions, not judgments of usefulness.
# Review file names, contents, sizes, permissions, and secrets before staging.
# Update v2: all six owner-confirmed metadata directory roots are allowed.

# --- Python-generated files and local environments ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
.conda/

# --- Local editor / operating-system files ---
.vscode/
.idea/
.DS_Store
._*
*.swp
*.swo
*~

# --- Credentials and machine-local environment files ---
# Keep only sanitized examples/templates; these exceptions do not verify contents.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.template
!*.env.example
!*.env.template
.ssh/
.codex/
*.pem
*.key
id_rsa
id_ed25519
/auth.json
/credentials.json

# --- Checkpoints and training-state directories, at any depth ---
save/
save_*/
checkpoints/
checkpoints_*/
*.pt
*.pth
*.ckpt
*.safetensors
*.pkl

# --- Training / scheduler / monitoring outputs, at any depth ---
logs/
logs_*/
*.log
slurm-*.out
slurm-*.err
events.out.tfevents.*
wandb/

# --- Raw datasets and known extracted-feature directories ---
/raw_data/
audio_pretrained_feature/
visual_pretrained_feature/

# --- Archives and editor backup copies ---
# Their contents remain on the server and are not backed up by the new repo.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak
*.bak[0-9]*

# --- Figure-output paths visible in the supplied tree ---
# Do not ignore *.png / *.jpg globally: images/model.jpg must remain eligible.
/experiments_phase_*/figs/
/experiments_phase_*/figs_*/
/ours*/figs/
/ours*/figs_*/
/fine_tuning*/figs/
/fine_tuning*/figs_*/
/figs_audio_ablation_compare/
/ours_2/metrics_backup/

# --- Confirmed versioned metadata directories ---
# The owner confirmed that these contain metadata, not raw datasets:
# /data/, /data2/, /data3/, /data_easy2hard/, /data_hard2easy/,
# /data_balance_random/.
# Intentionally NO ignore rules for these directory roots.
# Metadata files (e.g. .pkl, .npy, .npz, .json, .csv, .txt) remain eligible.
# Other rules (caches, credentials, named feature dirs, etc.) still apply.

# --- PENDING REVIEW: legacy scratch areas ---
# These may contain useful code. Excluded from the first import only.
# /drafts/
# /test_temp/

# --- PENDING REVIEW: selected analysis/result paths from the supplied tree ---
# These may contain code or curated results. Inspect before permanently excluding.
# No global analysis/, results/, or *.csv rule is used.
/experiments_phase_8_rdcrosssdc_modular/analysis/
/experiments_phase_5_modality_analysis/results/
/experiments_phase_5_modality_analysis_2/results/
/experiments_phase_3_analysis/analysis/
/experiments_phase_2_analysis/embedding_diagnostics/
/experiments_phase_1/analysis/
/experiments_phase_1/plots_confusion/
/experiments_phase_1/difficulty_analysis/
/experiments_phase_1/difficulty_analysis_recall/
/experiments_phase_1/confusion_dashboard/

# --- Intentionally NOT ignored by file type/name ---
# Python / shell / Slurm source files, rd_crosssdc/, model_patch/, grid_commands,
# commands.txt, VALIDATION.txt, README*.md, patches, and documentation images.
# No blanket *.txt, *.csv, *.json, *.yaml, *.yml, *.pkl, *.npy, *.npz, *.patch,
# *.png, or *.jpg rule: these formats can contain reproducibility inputs.
# A file inside an excluded parent directory is still excluded.

datasets
submit_*.sh
.agents
